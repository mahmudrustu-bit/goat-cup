# Bu dosyayı .env olarak kopyalayıp doldurun (yalnızca yerel test için).
# .env asla commit edilmez — gerçek değerler GitHub Secrets'a girilir.

# --- Meta / Instagram ---------------------------------------------------
# Instagram Business hesabının ID'si (KURULUM.md adım 3)
IG_USER_ID=17841400000000000
# Kalıcı System User token'ı (KURULUM.md adım 4)
IG_ACCESS_TOKEN=EAAG...
# Graph API sürümü. Meta eski sürümleri ~2 yıl sonra kapatır;
# gönderiler "unsupported version" hatası verirse burayı güncelleyin.
GRAPH_API_VERSION=v26.0

# --- Görsel barındırma --------------------------------------------------
# Boş bırakılırsa GITHUB_REPOSITORY'den raw.githubusercontent.com adresi
# türetilir (public repo şartı). Private repo'da GitHub Pages / CDN adresi girin.
IMAGE_BASE_URL=

# --- Claude -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max — caption için medium yeterli
CLAUDE_EFFORT=medium

# --- Davranış -----------------------------------------------------------
MAX_POSTS_PER_RUN=1
DRY_RUN=false
